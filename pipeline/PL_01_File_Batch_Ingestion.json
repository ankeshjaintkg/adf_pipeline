{
	"name": "PL_01_File_Batch_Ingestion",
	"properties": {
		"description": "CSV → ADLS Bronze",
		"activities": [
			{
				"name": "Lookup_File_Config",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"dataset": {
						"referenceName": "DS_File_Ingestion_Config",
						"type": "DatasetReference",
						"parameters": {
							"p_container": {
								"value": "@pipeline().parameters.p_SourceContainer",
								"type": "Expression"
							},
							"p_folder": {
								"value": "@concat( pipeline().parameters.p_SourceDirectory,'/config')",
								"type": "Expression"
							},
							"p_file": "file_ingestion_config.csv"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "ForEach_Files",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_File_Config",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_File_Config').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "CP_Source_To_Bronze",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "DS_CSV_SOURCE",
									"type": "DatasetReference",
									"parameters": {
										"p_container": {
											"value": "@pipeline().parameters.p_SourceContainer",
											"type": "Expression"
										},
										"p_directory": {
											"value": "@pipeline().parameters.p_SourceDirectory",
											"type": "Expression"
										},
										"p_files": {
											"value": "@item().SourceFileName",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "DS_CSV_BRONZE",
									"type": "DatasetReference",
									"parameters": {
										"p_container": {
											"value": "@pipeline().parameters.p_SourceContainer",
											"type": "Expression"
										},
										"p_directory": {
											"value": "@concat(pipeline().parameters.p_TargetFolder,'/',item().TargetFolder,'/ingestion_date=',formatDateTime(utcNow(),'dd-MM-yyyy'))\n",
											"type": "Expression"
										},
										"p_file_name": {
											"value": "@item().SourceFileName",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"p_SourceContainer": {
				"type": "string",
				"defaultValue": "ecom-data"
			},
			"p_SourceDirectory": {
				"type": "string",
				"defaultValue": "source"
			},
			"p_SourceFileName": {
				"type": "string",
				"defaultValue": "customers.csv"
			},
			"p_TargetFolder": {
				"type": "string",
				"defaultValue": "bronze"
			}
		},
		"annotations": []
	}
}