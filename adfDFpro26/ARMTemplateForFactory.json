{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfDFpro26"
		},
		"LS_ADLS_ECOM_DEV_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_ECOM_DEV'"
		},
		"LS_Source_Customers_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_Source_Customers'"
		},
		"LS_AZSQL_ECOM_DEV_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AZSQL_ECOM_DEV'"
		},
		"LS_ADLS_ECOM_DEV_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adfpro26.dfs.core.windows.net/"
		},
		"LS_Source_Customers_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adfpro26.dfs.core.windows.net/"
		},
		"LS_AZSQL_ECOM_DEV_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "dfpro25dbserver.database.windows.net"
		},
		"LS_AZSQL_ECOM_DEV_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldb"
		},
		"LS_AZSQL_ECOM_DEV_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admin25"
		},
		"LS_REST_API_ECOM_DEVLS_REST_API_ECOM_DEV_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://jsonplaceholder.typicode.com/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/PL_01_File_Batch_Ingestion')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "CSV → ADLS Bronze",
				"activities": [
					{
						"name": "Lookup_File_Config",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "DelimitedTextSource",
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "DelimitedTextReadSettings"
								}
							},
							"dataset": {
								"referenceName": "DS_File_Ingestion_Config",
								"type": "DatasetReference",
								"parameters": {
									"p_container": {
										"value": "@pipeline().parameters.p_SourceContainer",
										"type": "Expression"
									},
									"p_folder": {
										"value": "@concat( pipeline().parameters.p_SourceDirectory,'/config')",
										"type": "Expression"
									},
									"p_file": "file_ingestion_config.csv"
								}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "ForEach_Files",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Filter_Active_Files",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Lookup_File_Config').output.value",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "CP_Source_To_Bronze",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "DelimitedTextSource",
											"storeSettings": {
												"type": "AzureBlobFSReadSettings",
												"recursive": true,
												"enablePartitionDiscovery": false
											},
											"formatSettings": {
												"type": "DelimitedTextReadSettings"
											}
										},
										"sink": {
											"type": "DelimitedTextSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "DelimitedTextWriteSettings",
												"quoteAllText": true,
												"fileExtension": ".txt"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "DS_CSV_SOURCE",
											"type": "DatasetReference",
											"parameters": {
												"p_container": {
													"value": "@pipeline().parameters.p_SourceContainer",
													"type": "Expression"
												},
												"p_directory": {
													"value": "@pipeline().parameters.p_SourceDirectory",
													"type": "Expression"
												},
												"p_files": {
													"value": "@item().SourceFileName",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "DS_CSV_BRONZE",
											"type": "DatasetReference",
											"parameters": {
												"p_container": {
													"value": "@pipeline().parameters.p_SourceContainer",
													"type": "Expression"
												},
												"p_directory": {
													"value": "@concat(pipeline().parameters.p_TargetFolder,'/',item().TargetFolder,'/ingestion_date=',formatDateTime(utcNow(),'dd-MM-yyyy'))\n",
													"type": "Expression"
												},
												"p_file_name": {
													"value": "@item().SourceFileName",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						}
					},
					{
						"name": "Filter_Active_Files",
						"type": "Filter",
						"dependsOn": [
							{
								"activity": "Lookup_File_Config",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Lookup_File_Config').output.value",
								"type": "Expression"
							},
							"condition": {
								"value": "@equals(item().IsActive, '1')",
								"type": "Expression"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"p_SourceContainer": {
						"type": "string",
						"defaultValue": "ecom-data"
					},
					"p_SourceDirectory": {
						"type": "string",
						"defaultValue": "source"
					},
					"p_SourceFileName": {
						"type": "string",
						"defaultValue": "customers.csv"
					},
					"p_TargetFolder": {
						"type": "string",
						"defaultValue": "bronze"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_File_Ingestion_Config')]",
				"[concat(variables('factoryId'), '/datasets/DS_CSV_SOURCE')]",
				"[concat(variables('factoryId'), '/datasets/DS_CSV_BRONZE')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_02_SQL_Full_Load')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "SQL → ADLS Bronze",
				"activities": [
					{
						"name": "Lookup_SQL_Metadata",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": "SELECT\n    SourceSchema,\n    SourceTable,\n    TargetContainer,\n    TargetFolder,\n    LoadType\nFROM dbo.ETL_Metadata\nWHERE SourceSystem = 'AzureSQL'\n  AND LoadType = 'Full'\n  AND IsActive = 1;",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "AzureSqlTable1",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "ForEach_SQL_Tables",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Lookup_SQL_Metadata",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Lookup_SQL_Metadata').output.value",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "CP_SQL_To_Bronze",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "ParquetSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "ParquetWriteSettings"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "DS_SQL_SOURCE",
											"type": "DatasetReference",
											"parameters": {
												"p_SchemaName": {
													"value": "@item().SourceSchema",
													"type": "Expression"
												},
												"p_TableName": {
													"value": "@item().SourceTable",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "DS_PARQUET_BRONZE",
											"type": "DatasetReference",
											"parameters": {
												"p_container": {
													"value": "@item().TargetContainer",
													"type": "Expression"
												},
												"p_directory": {
													"value": "@concat(\n    item().TargetFolder,\n    '/ingestion_date=',\n    formatDateTime(utcNow(),'yyyy-MM-dd')\n)",
													"type": "Expression"
												},
												"p_file_name": {
													"value": "@concat(\n    item().SourceTable,\n    '.parquet'\n)",
													"type": "Expression"
												}
											}
										}
									]
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"p_TargetContainer": {
						"type": "string",
						"defaultValue": "bronze"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/AzureSqlTable1')]",
				"[concat(variables('factoryId'), '/datasets/DS_SQL_SOURCE')]",
				"[concat(variables('factoryId'), '/datasets/DS_PARQUET_BRONZE')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_03_SQL_Incremental_Load')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Watermark/incremental",
				"activities": [
					{
						"name": "Lookup_Incremental_Metadata",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": "SELECT\n    SourceSchema,\n    SourceTable,\n    TargetContainer,\n    TargetFolder,\n    LoadType,\n    WatermarkColumn\nFROM dbo.ETL_Metadata\nWHERE SourceSystem = 'AzureSQL'\n  AND LoadType = 'Incremental'\n  AND IsActive = 1;",
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "AzureSqlTable1",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "ForEach_Incremental_Tables",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Lookup_Incremental_Metadata",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Lookup_Incremental_Metadata').output.value",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "Lookup_Last_Watermark",
									"type": "Lookup",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "@concat(\n'SELECT LastWatermarkValue\n FROM dbo.ETL_Watermark\n WHERE SourceTable = ''',\nitem().SourceTable,\n'''\n AND WatermarkColumn = ''',\nitem().WatermarkColumn,\n''''\n)",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"dataset": {
											"referenceName": "AzureSqlTable1",
											"type": "DatasetReference",
											"parameters": {}
										}
									}
								},
								{
									"name": "CP_SQL_Incremental_To_Bronze",
									"type": "Copy",
									"dependsOn": [
										{
											"activity": "Lookup_Last_Watermark",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": "@concat(\n'SELECT *\n FROM ',\nitem().SourceSchema,\n'.',\nitem().SourceTable,\n' WHERE ',\nitem().WatermarkColumn,\n' > ''',\nactivity('Lookup_Last_Watermark').output.firstRow.LastWatermarkValue,\n''''\n)",
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "ParquetSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "ParquetWriteSettings"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "DS_SQL_SOURCE",
											"type": "DatasetReference",
											"parameters": {
												"p_SchemaName": {
													"value": "@item().SourceSchema",
													"type": "Expression"
												},
												"p_TableName": "@item().SourceTable"
											}
										}
									],
									"outputs": [
										{
											"referenceName": "DS_PARQUET_BRONZE",
											"type": "DatasetReference",
											"parameters": {
												"p_container": "@item().TargetContainer",
												"p_directory": "@concat(     item().TargetFolder,     '/ingestion_date=',     formatDateTime(utcNow(),'yyyy-MM-dd') )",
												"p_file_name": "@concat(     item().SourceTable,     '_incremental_',     formatDateTime(utcNow(),'yyyyMMddHHmmss'),     '.parquet' )"
											}
										}
									]
								},
								{
									"name": "Lookup_Max_Watermark",
									"type": "Lookup",
									"dependsOn": [
										{
											"activity": "CP_SQL_Incremental_To_Bronze",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": "@concat(\n'SELECT MAX(',\nitem().WatermarkColumn,\n') AS MaxWatermark\nFROM ',\nitem().SourceSchema,\n'.',\nitem().SourceTable,\n' WHERE ',\nitem().WatermarkColumn,\n' > ''',\nactivity('Lookup_Last_Watermark').output.firstRow.LastWatermarkValue,\n''''\n)",
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"dataset": {
											"referenceName": "AzureSqlTable1",
											"type": "DatasetReference",
											"parameters": {}
										}
									}
								},
								{
									"name": "IF_New_Data_Available",
									"type": "IfCondition",
									"dependsOn": [
										{
											"activity": "Lookup_Max_Watermark",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"expression": {
											"value": "@not(empty(activity('Lookup_Max_Watermark').output.firstRow.MaxWatermark))",
											"type": "Expression"
										},
										"ifTrueActivities": [
											{
												"name": "SP_Update_Watermark",
												"type": "SqlServerStoredProcedure",
												"dependsOn": [],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"storedProcedureName": "[[dbo].[usp_UpdateWatermark]",
													"storedProcedureParameters": {
														"SourceTable": {
															"value": "@item().SourceTable"
														},
														"NewWatermark": {
															"value": {
																"value": "@activity('Lookup_Max_Watermark').output.firstRow.MaxWatermark",
																"type": "Expression"
															}
														},
														"WatermarkColumn": {
															"value": "@item().WatermarkColumn"
														}
													}
												},
												"linkedServiceName": {
													"referenceName": "LS_AZSQL_ECOM_DEV",
													"type": "LinkedServiceReference"
												}
											}
										]
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"p_TargetContainer": {
						"type": "string",
						"defaultValue": "bronze"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/AzureSqlTable1')]",
				"[concat(variables('factoryId'), '/datasets/DS_SQL_SOURCE')]",
				"[concat(variables('factoryId'), '/datasets/DS_PARQUET_BRONZE')]",
				"[concat(variables('factoryId'), '/linkedServices/LS_AZSQL_ECOM_DEV')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_04_REST_API_Ingestion')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "REST API → Bronze",
				"activities": [
					{
						"name": "CP_REST_To_Bronze",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "RestSource",
								"httpRequestTimeout": "00:01:40",
								"requestInterval": "00.00:00:00.010",
								"requestMethod": "GET",
								"paginationRules": {
									"supportRFC5988": "true"
								}
							},
							"sink": {
								"type": "JsonSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "JsonWriteSettings"
								}
							},
							"enableStaging": false
						},
						"inputs": [
							{
								"referenceName": "DS_REST_SOURCE",
								"type": "DatasetReference",
								"parameters": {
									"p_relative_url": {
										"value": "@pipeline().parameters.p_relative_url",
										"type": "Expression"
									}
								}
							}
						],
						"outputs": [
							{
								"referenceName": "DS_JSON_BRONZE",
								"type": "DatasetReference",
								"parameters": {
									"p_container": {
										"value": "@pipeline().parameters.p_target_container",
										"type": "Expression"
									},
									"p_directory": {
